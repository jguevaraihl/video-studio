# Variables de entorno opcionales. La app no lee archivos .env: defínelas en PowerShell
# antes de iniciar. Si cambias el puerto, cambia también VS_BRIDGE_URL. Ejemplo:
#   $env:VS_BRIDGE_PORT = "8788"; $env:VS_BRIDGE_URL = "http://127.0.0.1:8788"; npm run dev
# NUNCA guardes la clave de Alibaba en un archivo: se pega en la app y vive solo en la memoria del puente.

# Puerto y dirección del puente local de IA (por defecto 8787 y 127.0.0.1).
VS_BRIDGE_PORT=8787
VS_BRIDGE_HOST=127.0.0.1

# Orígenes que el puente acepta, separados por comas.
# VS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Dirección del puente que usa el proxy de Vite.
# VS_BRIDGE_URL=http://127.0.0.1:8787

# 1 = servir el editor sin COOP/COEP (equivale a npm run dev:web:sin-aislamiento).
# VS_NO_ISOLATION=1
